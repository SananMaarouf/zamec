---
import "@/styles/global.css";
import { Navbar, type MenuItem } from "@/components/react/navbar";
import Footer from "@/components/Footer.astro";
import SEO from "@/components/SEO.astro";
import LanguageSwitch from "@/components/LanguageSwitch.astro";
import { loadQuery } from "@/sanity/lib/load-query";
import { SITE_SETTINGS_QUERY } from "@/sanity/lib/queries";
import { loadTheme } from "@/sanity/lib/theme-query";
import { themeFontsHref, themeToCss } from "@/lib/theme";
import { resolveLocale, localizedPath, type Locale } from "@/sanity/lib/locale";
import { uiText } from "@/lib/ui-strings";

interface Props {
  locale?: Locale | string;
  title?: string;
  description?: string;
  image?: { asset?: any; alt?: string };
  /** Path *without* the locale prefix, e.g. `/post/hello`. */
  path?: string;
  /** Error pages: emit `robots: noindex` and skip canonical/hreflang. */
  noindex?: boolean;
  /** `article` on blog posts, `website` everywhere else. */
  type?: "website" | "article";
  /** ISO publish date, for `article:published_time` and JSON-LD. */
  publishedAt?: string;
  /**
   * Home page only: the page has no visible heading of its own (it opens
   * straight into the gallery), so emit the site title as a screen-reader-only
   * H1 — crawlers and assistive tech otherwise see a heading-less document.
   */
  isHome?: boolean;
}

const locale = resolveLocale(Astro.props.locale ?? Astro.currentLocale);
const {
  title,
  description,
  image,
  path = "/",
  noindex = false,
  type = "website",
  publishedAt,
  isHome = false,
} = Astro.props;

// The palette is language-neutral and identical for every locale, so its GROQ
// query is locale-free and memoized across pages (see `theme-query.ts`), while
// site settings stay per-locale.
const [{ data: settings }, { data: theme }] = await Promise.all([
  loadQuery<any>({ query: SITE_SETTINGS_QUERY, params: { locale } }),
  loadTheme(),
]);

// CMS color palette -> CSS variables. Empty string when no theme doc exists,
// in which case the defaults in global.css apply.
const themeCss = themeToCss(theme);

// Google Fonts stylesheet for the two fonts chosen in the Studio (Theme →
// Fonts), or null when both are left on "site default" — then no external font
// request is made at all.
const fontsHref = themeFontsHref(theme);

const navTitle = settings?.title ?? "Astro × Sanity";

// Resolve CMS-driven nav items into the shape the React Navbar wants.
const menu: MenuItem[] = (settings?.navigation?.items ?? [])
  .map((item: any): MenuItem | null => {
    const ref = item.internalRef;
    let url = item.href ?? "";
    if (ref?._type && ref?.slug) {
      const segment =
        ref._type === "post"
          ? `/post/${ref.slug}`
          : ref._type === "category"
            ? `/category/${ref.slug}`
            : `/${ref.slug}`;
      url = localizedPath(locale, segment);
    } else if (url && !url.startsWith("http") && !url.startsWith("/")) {
      url = `/${url}`;
    }
    if (!item.label || !url) return null;
    return { title: item.label, url };
  })
  .filter(Boolean) as MenuItem[];

// The contact page is a template-owned route (there is no CMS document to
// reference), so its nav entry is appended here instead of coming from the
// Navigation document. Skip it when the editor already linked it themselves.
const contactUrl = localizedPath(locale, "/contact");
if (!menu.some((item) => item.url === contactUrl)) {
  menu.push({ title: uiText("contactNav", locale), url: contactUrl });
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <!-- Fonts selected in the Studio (Theme → Fonts). Preconnect first so the
         font request does not pay for a fresh DNS + TLS handshake. -->
    {
      fontsHref && (
        <>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link rel="stylesheet" href={fontsHref} />
        </>
      )
    }
    <meta name="generator" content={Astro.generator} />
    <SEO
      locale={locale}
      title={title}
      description={description}
      image={image}
      path={path}
      noindex={noindex}
      type={type}
      publishedAt={publishedAt}
    />
    {themeCss && <style is:inline set:html={themeCss} />}
    <script is:inline>
      const theme =
        localStorage.getItem("theme") ||
        (window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light");
      document.documentElement.classList.toggle("dark", theme === "dark");
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Navbar
      client:load
      logo={{
        url: localizedPath(locale, "/"),
        title: navTitle,
      }}
      menu={menu}
    >
      <LanguageSwitch size="sm" />
      <LanguageSwitch slot="mobileExtras" />
    </Navbar>
    <main class="flex-1">
      {isHome && <h1 class="sr-only">{navTitle}</h1>}
      <slot />
    </main>
    <Footer />
    <script is:inline>
      (() => {
        const setHeight = (el) =>
          document.documentElement.style.setProperty(
            "--navbar-height",
            `${el.offsetHeight}px`,
          );

        const attach = () => {
          const navbar = document.getElementById("site-navbar");
          if (!navbar) return false;
          setHeight(navbar);
          new ResizeObserver(() => setHeight(navbar)).observe(navbar);
          return true;
        };

        if (!attach()) {
          const mo = new MutationObserver(() => {
            if (attach()) mo.disconnect();
          });
          mo.observe(document.body, { childList: true, subtree: true });
        }
      })();
    </script>
  </body>
</html>
