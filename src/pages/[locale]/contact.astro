---
import Layout from "@/layouts/Layout.astro";
import ContactPage from "@/components/ContactPage.astro";
import { loadQuery } from "@/sanity/lib/load-query";
import { CONTACT_PAGE_QUERY } from "@/sanity/lib/queries";
import { NON_DEFAULT_LOCALES, type Locale } from "@/sanity/lib/locale";
import { uiText } from "@/lib/ui-strings";

// Builds `/nb/contact` → dist/nb/contact/index.html.
export async function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;

// Same CMS-owned copy as the default locale (see `contact.astro`).
const { data: page } = await loadQuery<any>({
  query: CONTACT_PAGE_QUERY,
  params: { locale },
});
---

<Layout
  locale={locale}
  title={page?.title ?? uiText("contactNav", locale)}
  description={page?.seoDescription ?? uiText("contactIntro", locale)}
  image={page?.ogImage}
  path="/contact"
>
  <ContactPage locale={locale} page={page} />
</Layout>
