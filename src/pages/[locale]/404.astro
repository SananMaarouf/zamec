---
import Layout from "@/layouts/Layout.astro";
import NotFound from "@/components/NotFound.astro";
import { NON_DEFAULT_LOCALES, type Locale } from "@/sanity/lib/locale";

// Builds `/nb/404` → dist/nb/404/index.html, which nginx serves for 404s under
// `/nb/` so Norwegian visitors get Norwegian copy.
export async function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
---
<Layout locale={locale} title="404" noindex>
  <NotFound locale={locale} />
</Layout>
