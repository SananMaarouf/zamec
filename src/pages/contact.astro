---
import Layout from "@/layouts/Layout.astro";
import ContactPage from "@/components/ContactPage.astro";
import { loadQuery } from "@/sanity/lib/load-query";
import { CONTACT_PAGE_QUERY } from "@/sanity/lib/queries";
import { DEFAULT_LOCALE } from "@/sanity/lib/locale";
import { uiText } from "@/lib/ui-strings";

const locale = DEFAULT_LOCALE;

// Editors own the heading, intro and form wording (the `contactPage`
// singleton); the form below it is template-owned. Optional with fallbacks, so
// a site without that document still gets a working contact page.
const { data: page } = await loadQuery<any>({
  query: CONTACT_PAGE_QUERY,
  params: { locale },
});
---

<Layout
  locale={locale}
  title={page?.title ?? uiText("contactNav", locale)}
  description={page?.seoDescription ?? uiText("contactIntro", locale)}
  image={page?.ogImage}
  path="/contact"
>
  <ContactPage locale={locale} page={page} />
</Layout>
