---
import Layout from "@/layouts/Layout.astro";
import PortableText from "@/components/PortableText.astro";
import { loadQuery } from "@/sanity/lib/load-query";
import { PAGE_SLUGS_QUERY, PAGE_BY_SLUG_QUERY } from "@/sanity/lib/queries";
import { DEFAULT_LOCALE } from "@/sanity/lib/locale";
import { CONTACT_SLUG } from "@/lib/contact";

export async function getStaticPaths() {
  const { data } = await loadQuery<Array<{ slug: string }>>({
    query: PAGE_SLUGS_QUERY,
    params: { locale: DEFAULT_LOCALE },
  });
  // `/contact` has its own route (with the form), so it must not be picked up
  // here as a generic CMS page too.
  return (data ?? [])
    .filter(({ slug }) => slug !== CONTACT_SLUG)
    .map(({ slug }) => ({ params: { page: slug } }));
}

const locale = DEFAULT_LOCALE;
const slug = Astro.params.page as string;

const { data: page } = await loadQuery<any>({
  query: PAGE_BY_SLUG_QUERY,
  params: { slug, locale },
});

if (!page) throw new Error(`Page not found: ${locale}/${slug}`);
---
<Layout
  locale={locale}
  title={page.title}
  description={page.seoDescription}
  image={page.ogImage}
  path={`/${slug}`}
>
  <article class="container mx-auto px-4 py-10 max-w-3xl prose dark:prose-invert">
    <h1>{page.title}</h1>
    {page.body && <PortableText value={page.body} />}
  </article>
</Layout>
