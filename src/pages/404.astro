---
import Layout from "@/layouts/Layout.astro";
import NotFound from "@/components/NotFound.astro";
import { DEFAULT_LOCALE } from "@/sanity/lib/locale";

// Astro emits `src/pages/404.astro` as `dist/404.html`, which `nginx.conf`
// serves from `error_page 404`. Everything else on this page is a normal layout.
const locale = DEFAULT_LOCALE;
---
<Layout locale={locale} title="404" noindex>
  <NotFound locale={locale} />
</Layout>
