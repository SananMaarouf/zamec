---
import { localizedPath, type Locale } from "@/sanity/lib/locale";
import { urlForImage } from "@/sanity/lib/url-for-image";

interface Props {
  title: string;
  slug: string;
  /** Production year of the work, shown under the title. */
  producedAt?: number;
  mainImage?: { asset?: any; alt?: string };
  /** Gallery images; the first one is used when there is no cover image. */
  images?: Array<{ asset?: any; alt?: string }>;
  locale: Locale;
}

const { title, slug, producedAt, mainImage, images, locale } = Astro.props;

const href = localizedPath(locale, `/post/${slug}`);
const image = mainImage?.asset ? mainImage : images?.[0];
const imgUrl = image?.asset
  ? urlForImage(image.asset).width(640).height(360).fit("crop").url()
  : null;

// A work is dated by its production year, so that is all the card shows — a
// full date here would read as a blog timestamp.
const yearLabel = producedAt ?? null;
---
<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-lg border border-border bg-card text-card-foreground shadow-sm transition-[transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
>
  {imgUrl && (
    <img
      src={imgUrl}
      alt={image?.alt ?? title}
      width="640"
      height="360"
      class="w-full aspect-video object-cover transition-transform duration-300 group-hover:scale-[1.03]"
      loading="lazy"
    />
  )}
  <div class="flex flex-1 flex-col p-5">
    <h3 class="font-semibold text-lg leading-snug transition-colors group-hover:text-primary">
      {title}
    </h3>
    {yearLabel && <p class="mt-2 text-sm text-muted-foreground">{yearLabel}</p>}
  </div>
</a>
