---
import { localizedPath, type Locale } from "@/sanity/lib/locale";
import { urlForImage } from "@/sanity/lib/url-for-image";

interface Props {
  title: string;
  slug: string;
  publishedAt?: string;
  mainImage?: { asset?: any; alt?: string };
  locale: Locale;
}

const { title, slug, publishedAt, mainImage, locale } = Astro.props;

const href = localizedPath(locale, `/post/${slug}`);
const imgUrl = mainImage?.asset
  ? urlForImage(mainImage.asset).width(640).height(360).fit("crop").url()
  : null;

const dateLabel = publishedAt
  ? new Date(publishedAt).toLocaleDateString(locale, {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;
---
<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-lg border border-border bg-card text-card-foreground shadow-sm transition-[transform,box-shadow] duration-200 hover:-translate-y-0.5 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
>
  {imgUrl && (
    <img
      src={imgUrl}
      alt={mainImage?.alt ?? title}
      width="640"
      height="360"
      class="w-full aspect-video object-cover transition-transform duration-300 group-hover:scale-[1.03]"
      loading="lazy"
    />
  )}
  <div class="flex flex-1 flex-col p-5">
    <h3 class="font-semibold text-lg leading-snug transition-colors group-hover:text-primary">
      {title}
    </h3>
    {dateLabel && (
      <p class="mt-2 text-sm text-muted-foreground">{dateLabel}</p>
    )}
  </div>
</a>
