---
import {
  LOCALES,
  DEFAULT_LOCALE,
  resolveLocale,
  type Locale,
} from "@/sanity/lib/locale";
import { mobileSheetLinkClassName } from "@/components/react/mobile-nav-styles";
import LanguageFlag from "@/components/LanguageFlag.astro";
import { cn } from "@/lib/utils";

const current = resolveLocale(Astro.currentLocale);

function stripLocalePrefix(pathname: string): string {
  for (const loc of LOCALES) {
    if (loc === DEFAULT_LOCALE) continue;
    if (pathname === `/${loc}` || pathname === `/${loc}/`) return "/";
    if (pathname.startsWith(`/${loc}/`)) return pathname.slice(`/${loc}`.length);
  }
  return pathname;
}

const basePath = stripLocalePrefix(Astro.url.pathname);

function hrefFor(loc: Locale): string {
  if (loc === DEFAULT_LOCALE) return basePath || "/";
  return basePath === "/" ? `/${loc}/` : `/${loc}${basePath}`;
}

const labels: Record<Locale, string> = {
  en: "English",
  nb: "Norsk",
};
---
{/* Rendered as plain menu entries (same type scale and left edge as the other
    links), each with its flag. The current language is tinted with the accent. */}
<div class="flex w-full flex-col gap-8">
  {LOCALES.map((loc) => (
    <a
      href={hrefFor(loc)}
      hreflang={loc}
      aria-current={loc === current ? "true" : undefined}
      class={cn(
        mobileSheetLinkClassName,
        "flex items-center gap-3",
        loc === current
          ? "text-primary"
          : "text-muted-foreground hover:text-foreground",
      )}
    >
      <LanguageFlag locale={loc} class="h-6 w-8 shrink-0 rounded-xs" />
      {labels[loc]}
    </a>
  ))}
</div>
