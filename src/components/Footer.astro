---
import { loadQuery } from "@/sanity/lib/load-query";
import { FOOTER_QUERY } from "@/sanity/lib/queries";
import { resolveLocale } from "@/sanity/lib/locale";

const locale = resolveLocale(Astro.currentLocale);

const { data: footer } = await loadQuery<any>({
  query: FOOTER_QUERY,
  params: { locale },
});
---
<footer class="border-t border-border bg-muted/40">
  <div class="container mx-auto grid gap-8 px-4 py-12 text-sm sm:grid-cols-2 lg:grid-cols-4">
    {footer?.address && (
      <div>
        <h3 class="mb-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground">Address</h3>
        <p class="text-muted-foreground whitespace-pre-line">{footer.address}</p>
      </div>
    )}
    {footer?.email && (
      <div>
        <h3 class="mb-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground">Email</h3>
        <a class="text-muted-foreground hover:underline" href={`mailto:${footer.email}`}>
          {footer.email}
        </a>
      </div>
    )}
    {footer?.cellNumber && (
      <div>
        <h3 class="mb-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground">Phone</h3>
        <a class="text-muted-foreground hover:underline" href={`tel:${footer.cellNumber}`}>
          {footer.cellNumber}
        </a>
      </div>
    )}
    {footer?.instagramURL && (
      <div>
        <h3 class="mb-2 text-xs font-semibold uppercase tracking-wider text-muted-foreground">Instagram</h3>
        <a class="text-muted-foreground hover:underline" href={footer.instagramURL} rel="noopener noreferrer" target="_blank">
          @{footer.instagramURL.replace(/\/$/, "").split("/").pop()}
        </a>
      </div>
    )}
  </div>
  {footer?.copyright && (
    <div class="border-t border-border/60">
      <p class="container mx-auto px-4 py-4 text-center text-xs text-muted-foreground">
        {footer.copyright}
      </p>
    </div>
  )}
</footer>
