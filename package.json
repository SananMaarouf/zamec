{
  "name": "astro-sanity-i18n",
  "type": "module",
  "version": "1.5.0",
  "scripts": {
    "dev": "astro dev",
    "devs": "concurrently -n astro,sanity -c cyan,magenta \"npm run dev\" \"npm run sanity:dev\"",
    "build": "astro build && node scripts/postbuild-404.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "cf:preview": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "sanity:login": "sanity login",
    "sanity:create-project": "sanity projects create",
    "sanity:dev": "sanity dev",
    "sanity:build": "sanity build",
    "sanity:deploy": "sanity deploy",
    "sanity:dataset-create": "sanity dataset create",
    "sanity:dataset-list": "sanity dataset list",
    "sanity:dataset-export": "sanity dataset export",
    "sanity:dataset-import": "sanity dataset import",
    "sanity:cors-add": "sanity cors add",
    "sanity:extract": "sanity schema extract --path=schema.json --force",
    "sanity:typegen": "sanity typegen generate",
    "sanity:codegen": "npm run sanity:extract && npm run sanity:typegen"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "@astrojs/sitemap": "^3.7.4",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@sanity/client": "^7.22.0",
    "@sanity/image-url": "^2.0.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-form": "^1.33.5",
    "astro": "^7.4.0",
    "astro-portabletext": "^0.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "groq": "^4.22.0",
    "gsap": "^3.15.0",
    "lucide-react": "^0.548.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.3.1",
    "vite": "^8.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
