    "@types/react-dom": "^19.3.0",
    "@types/react-is": "^19.3.0",
    "concurrently": "^10.0.3",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "react-is": "^19.3.1",
    "sanity": "^6.19.0",
    "sanity-plugin-internationalized-array": "^5.3.6",
    "styled-components": "^6.6.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.0",
    "wrangler": "^4.155.0"
